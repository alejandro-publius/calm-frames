  "narration_cues": [
    {
      "id": "n01",
      "start": 0,
      "end": 12,
      "text": "Some evenings, Rowan wants one quiet scene, and the choice to stay with it."
    },
    {
      "id": "n02",
      "start": 12,
      "end": 22,
      "text": "Calm Frames is a native Fire TV app for deliberate ambient viewing."
    },
    {
      "id": "n03",
      "start": 22,
      "end": 34,
      "text": "Choose McWay Falls, check the scene details, then choose Watch. Nothing starts just because you browse."
    },
    {
      "id": "n04",
      "start": 34,
      "end": 45,
      "text": "Now, a real, uninterrupted moment from the app."
    },
    {
      "id": "n05",
      "start": 115,
      "end": 125,
      "text": "Leaving should not erase a place. Returning should still be a choice."
    },
    {
      "id": "n06",
      "start": 125,
      "end": 145,
      "text": "Return to the same profile and edition to choose Resume or Start over. Saved progress does not restore weaker protection settings."
    },
    {
      "id": "n07",
      "start": 145,
      "end": 155,
      "text": "A shared screen can still hold a personal place. Each profile keeps its own progress."
    },
    {
      "id": "n08",
      "start": 155,
      "end": 164,
      "text": "Playback Proof explains the prepared file. It cannot authorize playback or remove a protective cover."
    }
  ],
