diff --git a/test/w3cmedia/ShakaPlayer.test.ts b/test/w3cmedia/ShakaPlayer.test.ts
new file mode 100644
index 0000000..610284f
--- /dev/null
+++ b/test/w3cmedia/ShakaPlayer.test.ts
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: MIT-0
+
+// The setup file mocks the wrapper. Exercise its real load/internalLoad pair,
+// replacing only the generated engine and import-time native polyfills.
+jest.mock(
+  '../../src/w3cmedia/polyfills/DocumentPolyfill',
+  () => ({
+    install: jest.fn(),
+  }),
+  { virtual: true },
+);
+jest.mock(
+  '../../src/w3cmedia/polyfills/ElementPolyfill',
+  () => ({
+    install: jest.fn(),
+  }),
+  { virtual: true },
+);
+jest.mock(
+  '../../src/w3cmedia/polyfills/TextDecoderPolyfill',
+  () => ({
+    install: jest.fn(),
+  }),
+  { virtual: true },
+);
+jest.mock(
+  '../../src/w3cmedia/polyfills/W3CMediaPolyfill',
+  () => ({
+    install: jest.fn(),
+  }),
+  { virtual: true },
+);
+jest.mock(
+  '../../src/w3cmedia/polyfills/MiscPolyfill',
+  () => ({
+    install: jest.fn(),
+  }),
+  { virtual: true },
+);
+jest.mock(
+  '../../src/w3cmedia/polyfills/DOMParserPolyfill',
+  () => ({
+    install: jest.fn(),
+  }),
+  { virtual: true },
+);
+jest.mock(
+  '../../src/w3cmedia/shakaplayer/dist/shaka-player.compiled',
+  () => ({
+    polyfill: { installAll: jest.fn() },
+    net: {
+      NetworkingEngine: {
+        unregisterScheme: jest.fn(),
+        registerScheme: jest.fn(),
+        PluginPriority: { APPLICATION: 1 },
+      },
+      HttpFetchPlugin: { isSupported: () => true, parse: jest.fn() },
+    },
+    config: { AutoShowText: { ALWAYS: 1 } },
+    Player: jest.fn(),
+  }),
+  { virtual: true },
+);
+
+const { ShakaPlayer } = jest.requireActual(
+  '../../src/w3cmedia/shakaplayer/ShakaPlayer',
+);
+const engine = jest.requireMock(
+  '../../src/w3cmedia/shakaplayer/dist/shaka-player.compiled',
+);
+
+function pendingLoad() {
+  let resolve!: () => void;
+  let reject!: (error: Error) => void;
+  const pending = new Promise<void>((yes, no) => {
+    resolve = yes;
+    reject = no;
+  });
+  const player = {
+    getNetworkingEngine: () => ({
+      clearAllRequestFilters: jest.fn(),
+      clearAllResponseFilters: jest.fn(),
+      registerRequestFilter: jest.fn(),
+      registerResponseFilter: jest.fn(),
+    }),
+    configure: jest.fn(),
+    load: jest.fn(() => pending),
+    setTextTrackVisibility: jest.fn(),
+  };
+  engine.Player.mockImplementation(() => player);
+  const wrapper = new ShakaPlayer(null, { secure: false, abrEnabled: true });
+  const content = {
+    uri: 'https://example.invalid/manifest.m3u8',
+    vcodec: 'avc1',
+    acodec: 'mp4a',
+    drm_scheme: '',
+  };
+  return { wrapper, content, player, resolve, reject };
+}
+
+describe('real Shaka wrapper load promise', () => {
+  it('returns a promise that fulfills after engine load and text visibility', async () => {
+    const { wrapper, content, player, resolve } = pendingLoad();
+    const result = wrapper.load(content, false);
+    expect(player.load).toHaveBeenCalledWith(content.uri);
+    expect(player.setTextTrackVisibility).not.toHaveBeenCalled();
+    // Resolve even under the dropped-return mutation, leaving no pending work.
+    resolve();
+    expect(result).toEqual(
+      expect.objectContaining({ then: expect.any(Function) }),
+    );
+    await result;
+    expect(player.setTextTrackVisibility).toHaveBeenCalledTimes(1);
+    expect(player.setTextTrackVisibility).toHaveBeenCalledWith(true);
+  });
+
+  it('returns the engine rejection without enabling text tracks', async () => {
+    const { wrapper, content, player, reject } = pendingLoad();
+    const error = new Error('manifest unavailable');
+    const result = wrapper.load(content, false);
+    expect(result).toEqual(
+      expect.objectContaining({ then: expect.any(Function) }),
+    );
+    const rejected = result.catch((reason: Error) => reason);
+    reject(error);
+    await expect(rejected).resolves.toBe(error);
+    expect(player.load).toHaveBeenCalledWith(content.uri);
+    expect(player.setTextTrackVisibility).not.toHaveBeenCalled();
+  });
+});
