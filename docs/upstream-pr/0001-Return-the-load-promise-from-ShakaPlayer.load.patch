From 0f834a91448782e80abed25e624db3d922a3e45d Mon Sep 17 00:00:00 2001
From: Your Name <you@example.com>
Date: Thu, 17 Sep 2026 20:14:55 -0700
Subject: [PATCH 1/2] Return the load promise from ShakaPlayer.load()

load() called internalLoad() without returning or awaiting it, so a
rejection from this.player.load(content.uri) became an unhandled
rejection and no caller could see that the load had failed.

The body is unchanged. load() now returns that promise and its return
type changes from void to Promise<void>, so a caller can attach a
handler to it. A caller that ignores the return value behaves exactly
as it did before.
---
 src/w3cmedia/shakaplayer/ShakaPlayer.ts | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/w3cmedia/shakaplayer/ShakaPlayer.ts b/src/w3cmedia/shakaplayer/ShakaPlayer.ts
index 2f21569..29ad6c9 100755
--- a/src/w3cmedia/shakaplayer/ShakaPlayer.ts
+++ b/src/w3cmedia/shakaplayer/ShakaPlayer.ts
@@ -197,7 +197,7 @@ export class ShakaPlayer implements PlayerInterface {
   }
   // End custom callbacks }}}
 
-  load(content: any, _autoplay: boolean): void {
+  load(content: any, _autoplay: boolean): Promise<void> {
     // Native HLS parsing setup
     if (ShakaPlayer.enableNativeParsing) {
       if (
@@ -453,8 +453,10 @@ export class ShakaPlayer implements PlayerInterface {
       });
     }
 
-    this.internalLoad(content);
     console.log('shakaplayer: load() OUT');
+    // Returned so the caller can see a rejected manifest or segment fetch.
+    // Before this, a failed load became an unhandled rejection.
+    return this.internalLoad(content);
   }
   private async internalLoad(content: any) {
     await this.player.load(content.uri);
-- 
