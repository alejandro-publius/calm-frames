{
  "name": "calm-frames-app",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf build bundle kepler-build node_modules generated coverage shaka-setup/shaka-player",
    "postinstall": "npm run setup:player",
    "build": "npm-run-all compile lint:fix test",
    "compile": "tsc -p tsconfig.json",
    "test:snapshot": "jest --colors --updateSnapshot",
    "start": "react-native start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --colors --coverage",
    "test:clearCache": "jest --clearCache",
    "lint": "eslint src --ext .ts,.tsx && eslint test --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix && eslint test --ext .ts,.tsx --fix",
    "start:simulator": "kepler device simulator start",
    "app:install": "kepler device install-app --dir .",
    "app:install:debug": "kepler device install-app -b Debug --dir .",
    "app:launch": "kepler device launch-app",
    "app:build:debug": "run-s build:debug && npm run app:install:debug && npm run app:launch",
    "app:build": "run-s build:release && npm run app:install && npm run app:launch",
    "build:release": "react-native build-kepler --build-type Release",
    "build:debug": "react-native build-kepler --build-type Debug",
    "prebuild:release": "node tools/check_native_inputs.mjs && node tools/check_prepared_library.mjs --require-reports && node tools/approved_baked_ambient.mjs --check && node tools/playback_proof.mjs --check",
    "prebuild:debug": "node tools/check_native_inputs.mjs && node tools/check_prepared_library.mjs --require-reports && node tools/approved_baked_ambient.mjs --check && node tools/playback_proof.mjs --check",
    "postbuild:release": "node tools/check_prepared_library.mjs --packages Release",
    "postbuild:debug": "node tools/check_prepared_library.mjs --packages Debug",
    "build:app": "npm-run-all build:release build:debug",
    "ui:capture": "jest --ci --coverage=false test/calmframes/uiCapture.test.tsx",
    "ui:flashmap": "npm run ui:capture && node tools/ui_flashmap.mjs",
    "setup:player": "cd shaka-setup && ./build.sh && ./copyOutputs.sh",
    "check:native-inputs": "node tools/check_native_inputs.mjs"
  },
