  "eslintConfig": {
    "extends": "@react-native",
    "root": true,
    "ignorePatterns": [
      "src/w3cmedia/shakaplayer/dist/"
    ],
    "rules": {
      "no-restricted-properties": [
        "error",
        {
          "property": "setNativeProps",
          "message": "setNativeProps throws a TypeError on React Native 0.83. Drive the UI through state instead."
        }
      ],
      "no-restricted-syntax": [
        "error",
        {
          "selector": "MemberExpression[property.name='setNativeProps']",
          "message": "setNativeProps throws a TypeError on React Native 0.83. Drive the UI through state instead."
        },
        {
          "selector": "Literal[value='setNativeProps']",
          "message": "setNativeProps throws a TypeError on React Native 0.83. Drive the UI through state instead."
        },
        {
          "selector": "AssignmentExpression[left.type='MemberExpression'][left.property.name='currentTime']",
          "message": "Every way of moving the playhead goes through requestSeek from src/calmframes/useFlashGuard.ts, which covers before it seeks. Only that file writes currentTime or calls fastSeek; the sample's fallbacks, the chime's audio element and the menu sound's audio element are exempted by name, with the reason beside each."
        },
        {
          "selector": "AssignmentExpression[left.type='MemberExpression'][left.computed=true][left.property.value='currentTime']",
          "message": "Every way of moving the playhead goes through requestSeek from src/calmframes/useFlashGuard.ts, which covers before it seeks. Only that file writes currentTime or calls fastSeek; the sample's fallbacks, the chime's audio element and the menu sound's audio element are exempted by name, with the reason beside each."
        },
        {
