{
  "name": "@calm-frames/flash-guard",
  "version": "0.1.0",
  "description": "A drop in flash guard for Vega video apps: verified flash maps, a cover that hides flagged parts while sound and captions keep playing, cards, VoiceView announcements and one safe seek path.",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src/index.ts",
    "src/pixelUtils.ts",
    "src/mirror.json",
    "src/engine",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vega",
    "fire-tv",
    "accessibility",
    "photosensitive-epilepsy",
    "wcag-2.3.1"
  ],
  "peerDependencies": {
    "@amazon-devices/kepler-media-controls": ">=1.0.0",
    "@amazon-devices/react-linear-gradient": ">=2.0.0",
    "@amazon-devices/react-native-w3cmedia": ">=2.3.0",
    "react": ">=19.0.0",
    "react-native": ">=0.83.0",
    "@amazon-devices/react-native-kepler": ">=4.0.0",
    "@amazon-devices/react-native-svg": ">=3.0.0"
  },
  "scripts": {
    "sync": "node tools/sync.mjs",
    "test:package": "node --test tools/check_package.test.mjs",
    "check:package": "node tools/check_package.mjs"
  }
}
