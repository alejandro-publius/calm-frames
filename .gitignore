# Media: downloads and hazard files never get committed.
# Only the license ledger, hash files and the folder README are tracked.
media/*
!media/LICENSES.csv
!media/*.sha256
!media/README.md

# Map-signing keys: private keys never enter the repo, public keys may.
*.pem
!*.pub.pem

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
dist/
build/

# Node and Vega builds
node_modules/
*.vpkg
app/build/
app/bundle/
app/kepler-build/
app/generated/
app/coverage/
app/shaka-setup/shaka-player/

# AWS CDK
cdk.out/

# Local environment and editors
.env
.env.*
.DS_Store
.idea/
.vscode/
app/buildinfo.json

# Local run logs, never committed
.logs/

# The prepared-library exporter's 0-byte flock file, recreated on every export
app/assets/raw/prepared-library/.local-library.lock

# CDK writes availability-zone lookups here on a real deploy; it holds the account id
pipeline/infra/cdk.context.json

# Agent worktrees made by the session tooling; never part of the repository.
.claude/worktrees/

# Coverage data from local pytest-cov runs.
.coverage
.coverage.*
